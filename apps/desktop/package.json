{
  "name": "dsh-plugin-desktop",
  "version": "2.0.6-alpha.19",
  "description": "EasyWork Electron carrier for a pinned DeepSeek Harness runtime Profile",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hicms/EasyWork.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/easywork-main.js",
  "files": [
    "build/app-icon.ico",
    "build/app-icon.png",
    "build/app-icon-mac.png",
    "build/tray-icon.svg",
    "build/tray-icon*.png",
    "lib/easywork-main.js",
    "lib/startup-preload.cjs",
    "lib/startup-trace.mjs",
    "README.md",
    "README.zh.md",
    "THIRD_PARTY_NOTICES.md",
    "lib/desktop-updater.cjs",
    "lib/desktop-updater-LICENSES.txt"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node ../../scripts/generate-brand-assets.mjs && node scripts/generate-app-icon.mjs && node scripts/generate-windows-app-icon.mjs && node scripts/generate-mac-app-icon.mjs && node scripts/generate-tray-icons.mjs && node scripts/clean.mjs && node scripts/updater-licenses.mjs && tsdown && tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "check": "yarn run build && yarn run typecheck",
    "check:win-package": "yarn run check",
    "check:mac-package": "yarn run check",
    "start": "node scripts/start-easywork.mjs",
    "dev": "yarn run build && yarn run prepare:easywork-runtime && yarn run prepare:easywork-primary-runtime && yarn run prepare:easywork-command && yarn run start",
    "package:dir": "yarn run build && yarn run prepare:easywork-runtime && yarn run prepare:easywork-primary-runtime && yarn run prepare:easywork-command && node scripts/package-dir.mjs",
    "dist:mac": "yarn run prepare:easywork-runtime && yarn run prepare:easywork-primary-runtime && yarn run prepare:easywork-command && node scripts/release-mac.ts",
    "dist:mac-smoke": "yarn run prepare:easywork-runtime && yarn run prepare:easywork-primary-runtime && yarn run prepare:easywork-command && node scripts/package-mac.ts",
    "dist:win": "yarn run prepare:easywork-runtime && yarn run prepare:easywork-primary-runtime && yarn run prepare:easywork-command && node scripts/package-win.ts",
    "dist:win-portable": "yarn run prepare:easywork-runtime && yarn run prepare:easywork-primary-runtime && yarn run prepare:easywork-command && node scripts/package-win-portable.ts",
    "prepare:easywork-runtime": "node scripts/prepare-easywork-runtime.mjs",
    "prepare:easywork-primary-runtime": "node scripts/prepare-easywork-primary-runtime.mjs",
    "prepare:easywork-command": "node scripts/prepare-easywork-command.mjs"
  },
  "peerDependencies": {
    "electron": "44.7.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@types/node": "^22.20.0",
    "@types/semver": "7.7.1",
    "adm-zip": "^0.6.0",
    "builder-util": "26.15.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.7",
    "electron-updater": "6.8.10",
    "js-yaml": "4.3.1",
    "sharp": "0.35.3",
    "tsdown": "0.22.2",
    "typescript": "6.0.3"
  },
  "build": {
    "appId": "io.techflag.dsh.ssh",
    "productName": "EasyWork",
    "executableName": "EasyWork",
    "asar": {
      "smartUnpack": true
    },
    "npmRebuild": false,
    "afterPack": "./scripts/verify-easywork-carrier.ts",
    "extraMetadata": {
      "dependencies": null
    },
    "afterAllArtifactBuild": "./scripts/verify-electron-fuses.ts",
    "electronFuses": {
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true,
      "runAsNode": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "files": [
      "lib/desktop-updater.cjs",
      "build/app-icon.ico",
      "build/app-icon.png",
      "build/app-icon-mac.png",
      "build/tray-icon.svg",
      "build/tray-icon*.png",
      "lib/easywork-main.js",
      "lib/startup-preload.cjs",
      "lib/startup-trace.mjs",
      "package.json",
      "!node_modules/**",
      {
        "from": "build/easywork-runtime/profiles/easywork",
        "to": "profiles/easywork",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!.easywork-startup-files.json"
        ]
      },
      {
        "from": "build/easywork-runtime/profiles/easywork/node_modules",
        "to": "profiles/easywork/node_modules",
        "filter": [
          "**/*",
          "!**/*.d.ts",
          "!**/*.d.mts",
          "!**/*.d.cts",
          "!**/*.pdb",
          "!**/*.map",
          "!@trycua/cua-driver-*/**"
        ]
      }
    ],
    "mac": {
      "artifactName": "EasyWork-${version}-${arch}.${ext}",
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "LSUIElement": true,
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh_CN"
        ]
      },
      "hardenedRuntime": true,
      "icon": "build/app-icon-mac.png",
      "notarize": true,
      "signIgnore": [
        "\\.(?:pak|dat|wasm)$"
      ]
    },
    "dmg": {
      "format": "UDBZ"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EasyWork-${version}-${arch}-Portable.${ext}",
      "icon": "build/app-icon.ico"
    },
    "nsis": {
      "installerIcon": "build/app-icon.ico",
      "license": "THIRD_PARTY_NOTICES.md",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": true,
      "shortcutName": "EasyWork",
      "uninstallerIcon": "build/app-icon.ico",
      "useZip": false,
      "artifactName": "EasyWork-${version}-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/app-icon.png"
    },
    "extraResources": [
      {
        "from": "build/easywork-runtime",
        "to": "easywork-runtime",
        "filter": [
          "runtime/cli/**",
          "package-cache/**",
          "node/**",
          "primary-runtime/**",
          "office-skills/**"
        ]
      },
      {
        "from": "build/easywork-runtime/profiles/easywork/node_modules/@trycua",
        "to": "node_modules/@trycua",
        "filter": [
          "cua-driver-*/**/*"
        ]
      },
      {
        "from": "lib/desktop-updater-LICENSES.txt",
        "to": "licenses/desktop-updater-LICENSES.txt"
      }
    ],
    "asarUnpack": [
      "build/app-icon*.png",
      "build/tray-icon*.png",
      "build/easywork-runtime/profiles/easywork/**/*.{node,dll,exe,pyd,dylib,so}",
      "build/easywork-runtime/profiles/easywork/**/*.so.*",
      "build/easywork-runtime/profiles/easywork/**/spawn-helper",
      "build/easywork-runtime/profiles/easywork/**/bin/rg",
      "build/easywork-runtime/profiles/easywork/**/libreoffice-kit-*/**/*"
    ],
    "generateUpdatesFilesForAllChannels": false,
    "publish": {
      "provider": "github",
      "repo": "EasyWork",
      "owner": "hicms"
    }
  }
}
